---
import "../styles/global.css";
import {
  Sun,
  Cloud,
  CloudRain,
  CloudSnow,
  CloudFog,
  CloudSun,
} from "lucide-react";
import { Smile, Frown, CloudDrizzle, Meh, Sparkles } from "lucide-react";
import { getIcon } from "../lib/icons";
import { getQuote } from "../lib/quotes";
import SeasonalOverlay from "./SeasonalOverlay.astro";

const { date, weather, temp, title, mood, lunch } = Astro.props;

const { name, ascii } = getIcon(date ?? "whale");

const quote = getQuote(date ?? "default");

const weatherMap = {
  sunny: Sun,
  partlysunny: CloudSun,
  cloudy: Cloud,
  rain: CloudRain,
  snow: CloudSnow,
  fog: CloudFog,
};
const moodMap = {
  happy: Smile,
  sad: Frown,
  weary: CloudDrizzle,
  surprised: Sparkles,
  calm: Meh,
};

const WeatherIcon = weatherMap[weather?.toLowerCase()] ?? Cloud;
const MoodIcon = moodMap[mood?.toLowerCase()] ?? Meh;
---

<div class="min-h-screen bg-[#242425] text-white flex justify-center relative">
  <SeasonalOverlay />
  <!-- BACK -->
  <div class="w-full max-w-5xl p-10">
    <!-- HEADER SLOT -->
    <div class="flex justify-between items-center mb-6">
      <!-- LEFT: BACK (aligned with month title) -->
      <a
        href="/"
        class="text-3xl tracking-wide hover:text-blue-400 active:scale-90 transition"
      >
        &larr;
      </a>

      <!-- RIGHT: empty placeholder to preserve layout -->
      <div class="opacity-0 text-xl font-semibold tracking-wide">
        placeholder
      </div>
    </div>

    <!-- BODY -->
    <div class="flex justify-center">
      <div class="w-full px-16">
        <div class="grid grid-cols-[360px_1fr] gap-24 items-center">
          <!-- LEFT -->
          <div class="flex justify-center">
            <div class="flex items-center h-full">
              <div
                class="w-20 h-20 rounded-2xl bg-zinc-800 flex items-center justify-center"
              >
                <pre
                  class="font-mono leading-none text-[14px] whitespace-pre">{ascii}</pre>
              </div>
            </div>
          </div>

          <!-- RIGHT -->
          <div class="min-w-0 pr-8">
            <div>
              <p class="text-lg text-zinc-200 italic">
                "{quote.text}"
              </p>
              <p class="text-xs text-zinc-500 mt-2">
                &mdash; {quote.author}
              </p>
            </div>

            <!-- DIVIDER -->
            <hr class="border-dashed border-zinc-700 my-4" />

            <!-- META -->
            <div class="space-y-2 text-xl text-zinc-300">
              <div>
                <span class="text-zinc-500">Date:&nbsp;&nbsp;</span>
                {date}
              </div>

              <div class="flex items-center gap-2 whitespace-nowrap">
                <span class="text-zinc-500">Weather:</span>
                <WeatherIcon class="w-5 h-5 text-zinc-300" />
              </div>

              <div>
                <span class="text-zinc-500">Temperature:&nbsp;&nbsp;</span>
                {temp ?? "—"}
              </div>

              <div class="flex items-center gap-2">
                <span class="text-zinc-500">Mood:</span>
                <MoodIcon class="w-5 h-5 text-zinc-300" />
              </div>

              <div>
                <span class="text-zinc-500">Title:&nbsp;&nbsp;</span>
                {title ?? "—"}
              </div>

              <hr class="border-dashed border-zinc-700 my-4" />

              <slot />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
